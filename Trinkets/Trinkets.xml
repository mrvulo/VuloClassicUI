				</Texture>
				<Texture name = "Trinkets_MainDock_BOTTOMRIGHT" file = "Interface\Tooltips\UI-Tooltip-Border" alphaMode = "ADD" hidden = "true">
					<Size>
						<AbsDimension x = "16" y = "16"/>
					</Size>
