		<Frames>
			<CheckButton name = "Trinkets_Trinket0" inherits = "TrinketsMainTrinketTemplate" id = "13">
				<Anchors>
					<Anchor point = "TOPLEFT">
						<Offset>
							<AbsDimension x = "8" y = "-8"/>
						</Offset>
					</Anchor>
				</Anchors>
				<Scripts>
					<OnLoad>
						if WOW_PROJECT_ID == WOW_PROJECT_MAINLINE then
							self:SetPoint("TOPLEFT", 4, -4)
						else
							self:SetPoint("TOPLEFT", 8, -8)
						end
						self:RegisterForClicks("LeftButtonDown", "LeftButtonUp", "RightButtonUp")
						if self.cooldown then
							self.cooldown:SetSwipeColor(0, 0, 0, 0.8)
						end
						if self.icon then
							self.icon:SetAllPoints()
						end
					</OnLoad>
				</Scripts>
			</CheckButton>
			<Frame parent = "Trinkets_Trinket0" inherits = "TrinketsTimeTemplate"/>
			<Frame parent = "Trinkets_Trinket0" inherits = "TrinketsQueueTemplate"/>

			<CheckButton name = "Trinkets_Trinket1" inherits = "TrinketsMainTrinketTemplate" id = "14">
				<Anchors>
					<Anchor point = "BOTTOMRIGHT">
						<Offset>
							<AbsDimension x = "-8" y = "8"/>
						</Offset>
					</Anchor>
				</Anchors>
				<Scripts>
					<OnLoad>
						if WOW_PROJECT_ID == WOW_PROJECT_MAINLINE then
							self:SetPoint("BOTTOMRIGHT", -3, 3)
						else
							self:SetPoint("BOTTOMRIGHT", -8, 8)
						end
						self:RegisterForClicks("LeftButtonDown", "LeftButtonUp", "RightButtonUp")
						if self.cooldown then
							self.cooldown:SetSwipeColor(0, 0, 0, 0.8)
						end
						if self.icon then
							self.icon:SetAllPoints()
						end
					</OnLoad>
				</Scripts>
			</CheckButton>
			<Frame parent = "Trinkets_Trinket1" inherits = "TrinketsTimeTemplate"/>
			<Frame parent = "Trinkets_Trinket1" inherits = "TrinketsQueueTemplate"/>
		</Frames>
		<Scripts>
			<OnLoad>
				Trinkets.OnLoad(self)
			</OnLoad>
			<OnEvent>
				Trinkets.OnEvent(self, event, ...)
			</OnEvent>
			<OnMouseDown>
				Trinkets.MainFrame_OnMouseDown(self)
			</OnMouseDown>
			<OnMouseUp>
				Trinkets.MainFrame_OnMouseUp(self)
			</OnMouseUp>
			<OnShow>
				Trinkets.OnShow()
			</OnShow>
			<OnHide>
				Trinkets.OnHide()
			</OnHide>
		</Scripts>
	</Frame>
