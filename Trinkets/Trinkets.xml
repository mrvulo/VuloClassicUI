<Ui xmlns = "http://www.blizzard.com/wow/ui/" xmlns:xsi = "http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation = "http://www.blizzard.com/wow/ui/ ..\FrameXML\UI.xsd">
	<!-- Backdrop Template -->
	<Frame name = "TrinketsBackdropTemplate" mixin = "TrinketsBackdropTemplateMixin" virtual = "true">
		<Scripts>
			<OnLoad method = "OnBackdropLoaded"/>
			<OnSizeChanged method = "OnBackdropSizeChanged"/>
		</Scripts>
	</Frame>
	<!-- Worn trinkets template -->
	<CheckButton name = "TrinketsMainTrinketTemplate" inherits = "ActionButtonTemplate,SecureActionButtonTemplate" virtual = "true">
		<Scripts>
			<OnLoad>
				self:RegisterForClicks("LeftButtonUp", "RightButtonUp")
				if self.TogglePopup then
					self.TogglePopup = function() end
				end
			</OnLoad>
			<OnShow>
				if self.Arrow then
					self.Arrow:SetShown(false)
				end
			</OnShow>
			<PostClick>
				Trinkets.MainTrinket_OnClick(self, button, down)
			</PostClick>
			<OnEnter>
				if TrinketsOptions.MenuOnRight == "OFF" then
					Trinkets.BuildMenu()
				end
				Trinkets.WornTrinketTooltip(self)
			</OnEnter>
			<OnLeave>
				Trinkets.ClearTooltip()
			</OnLeave>
		</Scripts>
	</CheckButton>
	<!-- Menu trinkets template -->
	<CheckButton name = "TrinketsMenuTrinketTemplate" inherits = "ActionButtonTemplate" virtual = "true">
		<Scripts>
			<OnLoad>
				self:RegisterForClicks("LeftButtonUp", "RightButtonUp")
				if self.TogglePopup then
					self.TogglePopup = function() end
				end
				if self.cooldown then
					self.cooldown:SetSwipeColor(0, 0, 0, 0.8)
				end
				if self.icon then
					self.icon:SetAllPoints()
				end
			</OnLoad>
			<OnShow>
				if self.Arrow then
					self.Arrow:SetShown(false)
				end
			</OnShow>
			<PostClick>
				Trinkets.MenuTrinket_OnClick(self, button, down)
			</PostClick>
			<OnEnter>
				Trinkets.MenuTrinketTooltip(self)
			</OnEnter>
			<OnLeave>
				Trinkets.ClearTooltip()
			</OnLeave>
		</Scripts>
	</CheckButton>
	<!-- Cooldown time text template -->
	<Frame name = "TrinketsTimeTemplate" enableMouse = "false" virtual = "true">
		<Size>
			<AbsDimension x = "36" y = "12"/>
		</Size>
		<Anchors>
			<Anchor point = "BOTTOMRIGHT"/>
		</Anchors>
		<Layers>
			<Layer level = "OVERLAY">
				<FontString name = "$parentTime" inherits = "NumberFontNormal" justifyH = "CENTER"/>
			</Layer>
		</Layers>
	</Frame>
	<!-- Combat queue inset template -->
	<Frame name = "TrinketsQueueTemplate" enableMouse = "false" virtual = "true">
		<Size>
			<AbsDimension x = "18" y = "18"/>
		</Size>
		<Anchors>
			<Anchor point = "TOPLEFT">
				<Offset>
					<AbsDimension x = "-2" y = "2"/>
				</Offset>
			</Anchor>
		</Anchors>
		<Layers>
			<Layer level = "OVERLAY">
				<Texture name = "$parentQueue"/>
			</Layer>
		</Layers>
	</Frame>
