<Ui xmlns = "http://www.blizzard.com/wow/ui/" xmlns:xsi = "http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation = "http://www.blizzard.com/wow/ui/ ..\FrameXML\UI.xsd">
	<!--
		The one virtual template that has to stay XML for now.

		It used to live in Trinkets.xml, which is Lua as of the conversion. But a
		virtual template defined in Lua cannot be inherited by NAME, and
		TrinketsOpt.xml and TrinketsQueue.xml still inherit this one nine times
		between them. Deleting it with the rest produced nine of these:

			Couldn't find inherited node: TrinketsBackdropTemplate

		and every window built from it came up without its backdrop.

		This file goes away with the last XML file. Nothing new should be added
		to it: it exists to carry a dependency across an unfinished conversion,
		not to be a home for templates.

		(And note the punctuation. A double hyphen is not allowed inside an XML
		comment. Writing one here cost a round: the parser rejected the whole
		file, so the template below never existed and every window that inherits
		it came up without a backdrop again.)
	-->
	<Frame name = "TrinketsBackdropTemplate" mixin = "TrinketsBackdropTemplateMixin" virtual = "true">
		<Scripts>
			<OnLoad method = "OnBackdropLoaded"/>
			<OnSizeChanged method = "OnBackdropSizeChanged"/>
		</Scripts>
	</Frame>

	<!--
		These two came from TrinketsOpt.xml. TrinketsQueue.xml inherits the tab
		twice and the check button three times, so they have to outlive that
		file just as the backdrop did. Counted before moving them; the third
		template that file defined (Trinkets_SmallButtonTemplate) is used only
		there and became a Lua factory.
	-->
	<Button name = "Trinkets_TabTemplate" inherits = "UIPanelButtonGrayTemplate" virtual = "true">
		<Size>
			<AbsDimension x = "96" y = "28"/>
		</Size>
		<Scripts>
			<OnClick>
				Trinkets.Tab_OnClick(self:GetID())
			</OnClick>
		</Scripts>
		<NormalFont style = "GameFontHighlightSmall"/>
		<DisabledFont style = "GameFontDisableSmall"/>
		<HighlightFont style = "GameFontHighlightSmall"/>
	</Button>

	<CheckButton name = "Trinkets_CheckButtonTemplate" inherits = "UICheckButtonTemplate" virtual = "true">
		<Size>
			<AbsDimension x = "24" y = "24"/>
		</Size>
		<Scripts>
			<OnClick>
				Trinkets.CheckButton_OnClick(self)
			</OnClick>
			<OnEnter>
				Trinkets.OnTooltip(self)
			</OnEnter>
			<OnLeave>
				GameTooltip:Hide()
			</OnLeave>
		</Scripts>
	</CheckButton>
</Ui>
